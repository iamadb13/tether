# Tether configuration. Defaults target the local mocks used by `npm run demo`.
PORT=4000
DB_PATH=./data/tether.db
TIMEZONE=Europe/Bucharest           # business timezone: due dates are calendar days here

WORKFRONT_BASE_URL=https://<tenant>.my.workfront.com
WORKFRONT_API_KEY=change-me
WORKFRONT_WEBHOOK_TOKEN=change-me   # sent by Workfront event subscriptions in the Authorization header
WORKFRONT_RPS=10                    # client-side rate limit (token bucket)

JIRA_BASE_URL=https://<tenant>.atlassian.net
JIRA_EMAIL=integration@customer.example
JIRA_API_TOKEN=change-me
JIRA_PROJECT_KEY=ENG
JIRA_ISSUE_TYPE=Task
# Canonical status → your Jira status names (run `npm run preflight` to see what exists)
JIRA_STATUSES=todo=To Do,in_progress=In Progress,in_review=In Review,done=Done
# Needed only where Jira hides e-mail addresses: email=accountId,...
# JIRA_USER_MAP=ben@brand.example=557058:0123abcd
JIRA_WEBHOOK_SECRET=change-me       # HMAC secret configured on the Jira webhook
JIRA_RPS=10
JIRA_INDEX_LAG_MS=15000             # don't trust a negative marker search sooner than this (preflight --deep measures it)

ADMIN_TOKEN=change-me               # bearer token for /admin/* and the ops dashboard
RECONCILE_INTERVAL_MS=15000
HTTP_TIMEOUT_MS=5000
WORKER_CONCURRENCY=4
MAX_ATTEMPTS=8

# Field ownership when the same field changed on both sides: workfront | jira | latest | manual
POLICY_TITLE=workfront
POLICY_DESCRIPTION=workfront
POLICY_STATUS=jira
POLICY_DUE_DATE=manual
POLICY_PRIORITY=latest
POLICY_ASSIGNEE=latest
